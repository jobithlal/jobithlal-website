# Copy to .env (or .env.local) and fill in. Never commit real values.

# Public site URL (canonical URLs, sitemap, Open Graph, password-reset links)
NEXT_PUBLIC_SITE_URL=https://www.jobithlal.com
# Set to "false" on preview/staging deployments to block search engines
NEXT_PUBLIC_ALLOW_INDEXING=true

# --- Database (PostgreSQL) ---
# Without it the public site still runs from the built-in content, but the admin and
# inquiry storage are off. Hosted options: Neon, Supabase, or your host's PostgreSQL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# --- Admin ---
# Random secret (32+ chars) used to salt IP fingerprints. Generate: openssl rand -base64 32
AUTH_SECRET=
# One-time token that unlocks /admin/setup to create the first Super Admin.
# Remove it after setup. Leave empty to disable the setup page.
ADMIN_SETUP_TOKEN=

# --- Contact form + password-reset email (Resend — https://resend.com) ---
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. hello@jobithlal.com
CONTACT_FROM_EMAIL=
CONTACT_FROM_NAME=JOBITHLAL
# Where inquiries are delivered (defaults to the site email)
CONTACT_TO_EMAIL=jobithlal@gmail.com
# "true" to send visitors an acknowledgement email
CONTACT_SEND_CONFIRMATION=false

# --- Phase 6+ (not used yet) ---
# S3_ENDPOINT= S3_BUCKET= S3_ACCESS_KEY_ID= S3_SECRET_ACCESS_KEY= S3_PUBLIC_URL=
